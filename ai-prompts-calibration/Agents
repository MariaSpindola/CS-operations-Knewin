       Assign_Tag: "Expansao_Gargalo_Capacidade"
       Opportunity_Status: "VALIDATED"

  3. Validação de Intenção Comercial (Cross-sell/Upgrade):
     IF health_score >= 80.0
     AND (marketing_landing_page_clicks >= 2 OR pricing_page_visits >= 1)
     THEN:
       Assign_Tag: "Expansao_Intencao_Comercial"
       Opportunity_Status: "VALIDATED"

  4. Roteamento de Priorização:
     IF Opportunity_Status == "VALIDATED" AND mrr >= 2500.00:
       Route_To: "Agenda Consultiva Humana (Prioridade Expansao)"
     ELSE IF Opportunity_Status == "VALIDATED" AND mrr < 2500.00:
       Route_To: "Automacao de Nutricao e Proposta Self-Service"
